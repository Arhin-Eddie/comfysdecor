# Comfy's Decor Accessories - Environment Configuration Example
# Copy this file to .env and fill in your actual values:
# cp .env.example .env

# Neon PostgreSQL connection string (or any standard PostgreSQL database URI)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-instance.region.aws.neon.tech/neondb?sslmode=require

# Application HTTP Port (Default: 3000)
PORT=3000

# Administrator Credentials (Seeded on first initialization into admins table)
ADMIN_PASSWORD=comfy2026

# HMAC token signing secret for admin sessions
AUTH_SECRET=replace_with_a_secure_random_secret_phrase

# ==============================================================================
# Cloudflare R2 Object Storage (For catalog product & hero banner images)
# ==============================================================================
# Obtain from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
# If not configured, uploads will gracefully fall back to local storage (/assets/uploads)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=comfys-decor
# Public domain or R2 dev subdomain for fast global edge CDN distribution:
R2_PUBLIC_URL=https://pub-your_bucket_id.r2.dev
