{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "styles.css,app.js,index.html,site.webmanifest,robots.txt,assets/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}
